{
  "limits": {
    "max_assignments": null,
    "max_nodes": null,
    "max_placements": null,
    "max_profiles": 10,
    "time_limit_seconds": null,
    "stop_on_first_profile": true
  },
  "solver": {
    "enabled": true,
    "mode": "exact_partial",
    "max_graph_nodes_per_placement": 20000,
    "max_graph_edges_per_placement": 80000,
    "max_families_per_placement": 64,
    "max_expression_nodes": 10000,
    "validation_exponent": 2,
    "family_expansion": {
      "policy": "none",
      "maximum_exponent": 1,
      "max_specializations_per_family": 256
    }
  },
  "output": {
    "write_placements": false,
    "flush_every": 10,
    "write_candidates": true,
    "write_families": false,
    "write_unsupported": false,
    "write_word_cases": false,
    "write_errors": true,
    "max_error_records": 1000,
    "directory": "output/cases/c3"
  },
  "progress": {
    "enabled": true,
    "interval_seconds": 2,
    "percentage_step": 0.1
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "restart": false,
    "file": "checkpoint.sqlite3",
    "interval_seconds": 60
  },
  "filters": {
    "preword_pruning": {
      "enabled": true,
      "topology": {
        "enabled": true,
        "enable_endpoint_crossing": true,
        "max_intervals": 1024
      },
      "linear_invariants": {
        "enabled": true,
        "enable_radius_measures": true,
        "enable_smooth_turns": true,
        "enable_point_turns": true,
        "enable_isoperimetric": true,
        "sqrt_upper_bound_denominator": 1000
      }
    }
  },
  "enumeration": {
    "exterior_arc_repetition": {
      "enabled": true
    }
  },
  "maps": [
    "c3"
  ]
}
