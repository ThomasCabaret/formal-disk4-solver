{
  "input": {
    "candidates_file": "output/graph_lab/up-to-13/geometry_candidates.jsonl"
  },
  "output": {
    "directory": "output/graph_lab/up-to-13/geometry-recovery",
    "solutions_file": "geometric_solutions.jsonl",
    "summary_file": "geometry_recovery_summary.json",
    "checkpoint_file": "geometry_recovery_checkpoint.json",
    "failures_file": "geometry_failures.jsonl",
    "status_file": "geometry_status.sqlite3",
    "write_failures": true,
    "max_failure_records": 10000,
    "include_formal_candidate": true
  },
  "geometry": {
    "intermediate_points_per_generic_curve": 5,
    "arc_sample_count": 192,
    "max_restarts": 4096,
    "max_function_evaluations": 4000,
    "random_seed": 9173,
    "maximum_curve_length": 6.0,
    "minimum_curve_length": 1e-06,
    "maximum_generic_turn_per_joint_pi": 0.95,
    "optimization_clearance": 1e-05,
    "closure_tolerance": 1e-08,
    "tangent_tolerance": 1e-07,
    "angle_tolerance": 1e-07,
    "length_tolerance": 1e-08,
    "intersection_tolerance": 1e-07,
    "minimum_area": 1e-08,
    "minimum_sample_edge_length": 1e-09,
    "candidate_timeout_seconds": 60.0,
    "enable_clearance_refinement": true,
    "coarse_collision_sample_count": 16,
    "max_refinement_evaluations": 1000
  },
  "limits": {
    "max_candidates": null,
    "max_solutions": null,
    "stop_on_first_solution": false
  },
  "checkpoint": {
    "enabled": false,
    "resume": false,
    "restart": false
  },
  "recovery": {
    "primary_geometry_directory": "output/graph_lab/up-to-13/geometry",
    "primary_status_file": "geometry_status.sqlite3",
    "follow": true,
    "poll_seconds": 2.0,
    "batch_size": 1,
    "catalog_ingest_lines": 1000
  }
}
