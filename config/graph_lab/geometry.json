{
  "input": {
    "candidates_file": "output/graph_lab/up-to-13/geometry_candidates.jsonl"
  },
  "output": {
    "directory": "output/graph_lab/up-to-13/geometry",
    "solutions_file": "geometric_solutions.jsonl",
    "summary_file": "geometry_summary.json",
    "checkpoint_file": "geometry_checkpoint.json",
    "failures_file": "geometry_failures.jsonl",
    "write_failures": true,
    "max_failure_records": 1000,
    "include_formal_candidate": true
  },
  "geometry": {
    "intermediate_points_per_generic_curve": 3,
    "arc_sample_count": 80,
    "max_restarts": 128,
    "max_function_evaluations": 1500,
    "random_seed": 0,
    "maximum_curve_length": 6.0,
    "minimum_curve_length": 1e-06,
    "maximum_generic_turn_per_joint_pi": 0.95,
    "optimization_clearance": 1e-05,
    "closure_tolerance": 1e-08,
    "tangent_tolerance": 1e-07,
    "angle_tolerance": 1e-07,
    "length_tolerance": 1e-08,
    "intersection_tolerance": 1e-07,
    "minimum_area": 1e-08,
    "minimum_sample_edge_length": 1e-09,
    "candidate_timeout_seconds": 45.0,
    "resolution_schedule": [
      {
        "intermediate_points_per_generic_curve": 3,
        "candidate_timeout_seconds": 5.0
      },
      {
        "intermediate_points_per_generic_curve": 6,
        "candidate_timeout_seconds": 10.0
      },
      {
        "intermediate_points_per_generic_curve": 12,
        "candidate_timeout_seconds": 30.0
      }
    ],
    "enable_clearance_refinement": true,
    "coarse_collision_sample_count": 8,
    "max_refinement_evaluations": 320
  },
  "limits": {
    "max_candidates": null,
    "max_solutions": null,
    "stop_on_first_solution": false
  },
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "restart": false
  }
}
